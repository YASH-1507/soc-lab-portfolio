#Requires -RunAsAdministrator
<#
.SYNOPSIS
    CIS Windows 11 Enterprise Benchmark v3.0.0 - Round 1 Remediation

.DESCRIPTION
    Targets HIGH and MEDIUM severity CIS controls that can be applied
    without breaking standard workstation functionality.

    Controls intentionally excluded (Bluetooth, Print Spooler, camera,
    geolocation, sleep states) are listed at the end of this script
    with manual remediation steps.

    SECTIONS COVERED:
    - Section 1:  Account Policies (Password + Lockout via secedit)
    - Section 2:  Local Policies / Security Options (Registry)
    - Section 5:  System Services
    - Section 9:  Windows Firewall Logging
    - Section 17: Advanced Audit Policy
    - Section 18: Administrative Templates (Network, MSS hardening)

.NOTES
    Run from an elevated PowerShell session.
    Test in a lab/non-production environment before deploying.
    A system restart is recommended after execution.
#>

Set-StrictMode -Off
$ErrorActionPreference = "Continue"
$LogFile = "$env:TEMP\CIS_Remediation_Round1_$(Get-Date -Format 'yyyyMMdd_HHmm').log"

function Write-Log {
    param([string]$Msg, [string]$Level = "INFO")
    $ts = Get-Date -Format "HH:mm:ss"
    $line = "[$ts][$Level] $Msg"
    Write-Host $line -ForegroundColor $(if($Level -eq "OK"){"Green"} elseif($Level -eq "WARN"){"Yellow"} else{"Cyan"})
    Add-Content -Path $LogFile -Value $line
}

function Set-RegValue {
    param([string]$Path, [string]$Name, $Value, [string]$Type = "DWord")
    try {
        if (-not (Test-Path $Path)) { New-Item -Path $Path -Force | Out-Null }
        Set-ItemProperty -Path $Path -Name $Name -Value $Value -Type $Type -Force
        Write-Log "SET  $Path\$Name = $Value" "OK"
    } catch {
        Write-Log "FAIL $Path\$Name : $_" "WARN"
    }
}

Write-Log "=== CIS Win11 Enterprise - Round 1 Remediation Started ==="
Write-Log "Log file: $LogFile"
Write-Log ""

# -----------------------------------------------------------------------------
# SECTION 1 - ACCOUNT POLICIES (via secedit)
# CIS 1.1.3  Minimum password age >= 1 day
# CIS 1.1.4  Minimum password length >= 14
# CIS 1.2.1  Account lockout duration >= 15 min
# CIS 1.2.2  Account lockout threshold <= 5
# CIS 1.2.4  Reset lockout counter >= 15 min
# -----------------------------------------------------------------------------
Write-Log "--- Section 1: Account Policies ---"

$seceditCfg = "$env:TEMP\cis_secpol.cfg"
secedit /export /cfg $seceditCfg /quiet

if (Test-Path $seceditCfg) {
    $content = Get-Content $seceditCfg
    $content = $content -replace "MinimumPasswordAge\s*=\s*\d+",    "MinimumPasswordAge = 1"
    $content = $content -replace "MinimumPasswordLength\s*=\s*\d+", "MinimumPasswordLength = 14"
    $content = $content -replace "LockoutDuration\s*=\s*\d+",       "LockoutDuration = 15"
    $content = $content -replace "LockoutBadCount\s*=\s*\d+",       "LockoutBadCount = 5"
    $content = $content -replace "ResetLockoutCount\s*=\s*\d+",     "ResetLockoutCount = 15"
    $content | Set-Content $seceditCfg
    secedit /configure /db "$env:TEMP\cis_secedit.sdb" /cfg $seceditCfg /quiet
    Write-Log "Password/Lockout policies applied via secedit" "OK"
    Remove-Item $seceditCfg -Force -ErrorAction SilentlyContinue
} else {
    Write-Log "secedit export failed - apply password policies manually via secpol.msc" "WARN"
}

# CIS 1.1.6 - Relax minimum password length limits
Set-RegValue "HKLM:\System\CurrentControlSet\Control\SAM" "RelaxMinimumPasswordLengthLimits" 1

# -----------------------------------------------------------------------------
# SECTION 2 - LOCAL POLICIES / SECURITY OPTIONS (Registry)
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 2: Local Policies / Security Options ---"

$lsaPath   = "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa"
$msPath    = "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters"
$mssrvPath = "HKLM:\SYSTEM\CurrentControlSet\Services\LanManServer\Parameters"

# CIS 2.3.1.1 - Block Microsoft account logons
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" "NoConnectedUser" 3

# CIS 2.3.2.1 - Force audit policy subcategory settings
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" "SCENoApplyLegacyAuditPolicy" 1

# CIS 2.3.4.1 - Prevent users from installing printer drivers
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Print\Providers\LanMan Print Services\Servers" "AddPrinterDrivers" 1

# CIS 2.3.7.1 - Require CTRL+ALT+DEL at logon
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" "DisableCAD" 0

# CIS 2.3.7.2 - Do not display last signed-in username
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" "DontDisplayLastUserName" 1

# CIS 2.3.7.3 - Machine account lockout threshold = 10
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" "MaxDevicePasswordFailedAttempts" 10

# CIS 2.3.7.4 - Machine inactivity limit = 900 seconds (15 min)
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" "InactivityTimeoutSecs" 900

# CIS 2.3.7.7 - Cached logon count <= 4
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" "CachedLogonsCount" "4" "String"

# CIS 2.3.7.9 - Smart card removal = Lock Workstation
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" "ScRemoveOption" "1" "String"

# CIS 2.3.8.1 / 2.3.8.2 - SMB client: require and enable signing
Set-RegValue $msPath "RequireSecuritySignature" 1
Set-RegValue $msPath "EnableSecuritySignature"  1

# CIS 2.3.9.2 / 2.3.9.3 - SMB server: require and enable signing
Set-RegValue $mssrvPath "RequireSecuritySignature" 1
Set-RegValue $mssrvPath "EnableSecuritySignature"  1

# CIS 2.3.9.5 - SPN target name validation
Set-RegValue $mssrvPath "SmbServerNameHardeningLevel" 1

# CIS 2.3.10.3 - Restrict anonymous SAM/shares enumeration
Set-RegValue $lsaPath "RestrictAnonymousSAM" 1
Set-RegValue $lsaPath "RestrictAnonymous"    1

# CIS 2.3.10.4 - Do not store credentials for network auth
Set-RegValue $lsaPath "DisableDomainCreds" 1

# CIS 2.3.11.1 - Allow LocalSystem to use computer identity for NTLM
Set-RegValue $lsaPath "UseMachineId" 1

# CIS 2.3.11.4 - Kerberos: AES128 + AES256 only
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System\Kerberos\Parameters" "SupportedEncryptionTypes" 2147483640

# CIS 2.3.11.7 - LM auth level = NTLMv2 only, refuse LM and NTLM
Set-RegValue $lsaPath "LmCompatibilityLevel" 5

# CIS 2.3.11.9 / 2.3.11.10 - NTLM SSP: require NTLMv2 + 128-bit encryption
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa\MSV1_0" "NTLMMinClientSec" 537395200
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa\MSV1_0" "NTLMMinServerSec" 537395200

# CIS 2.3.11.11 - Audit incoming NTLM traffic
Set-RegValue $lsaPath "AuditReceivingNTLMTraffic" 2

# CIS 2.3.11.12 - Audit outgoing NTLM traffic
Set-RegValue $lsaPath "RestrictSendingNTLMTraffic" 1

# CIS 2.3.17.1 - UAC: Admin Approval Mode for built-in admin
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" "FilterAdministratorToken" 1

# CIS 2.3.17.2 - Elevation prompt for admins = consent on secure desktop
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" "ConsentPromptBehaviorAdmin" 2

# CIS 2.3.17.3 - Elevation prompt for standard users = auto-deny
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" "ConsentPromptBehaviorUser" 0

# -----------------------------------------------------------------------------
# SECTION 5 - SERVICES
# Note: Bluetooth, Print Spooler, and geolocation are in the manual
#       review section at the end - disable only if not needed.
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 5: System Services ---"

$servicesToDisable = @(
    @("MapsBroker",              "Downloaded Maps Manager"),
    @("lltdsvc",                 "Link-Layer Topology Discovery Mapper"),
    @("MSiSCSI",                 "Microsoft iSCSI Initiator"),
    @("RasAuto",                 "Remote Access Auto Connection Manager"),
    @("SessionEnv",              "Remote Desktop Configuration"),
    @("TermService",             "Remote Desktop Services"),
    @("UmRdpService",            "Remote Desktop Services UserMode Port Redirector"),
    @("RpcLocator",              "Remote Procedure Call Locator"),
    @("RemoteRegistry",          "Remote Registry"),
    @("RoutingAndRemoteAccess",  "Routing and Remote Access"),
    @("LanmanServer",            "Server"),
    @("simptcp",                 "Simple TCP/IP Services"),
    @("SNMP",                    "SNMP Service"),
    @("sacsvr",                  "Special Administration Console Helper"),
    @("SSDPSRV",                 "SSDP Discovery"),
    @("TlntSvr",                 "Telnet"),
    @("upnphost",                "UPnP Device Host"),
    @("WMSvc",                   "Web Management Service"),
    @("WerSvc",                  "Windows Error Reporting Service"),
    @("Wecsvc",                  "Windows Event Collector"),
    @("WpnService",              "Windows Push Notification System Service"),
    @("PushToInstall",           "Windows PushToInstall Service"),
    @("XboxGipSvc",              "Xbox Accessory Management Service"),
    @("XblAuthManager",          "Xbox Live Auth Manager"),
    @("XblGameSave",             "Xbox Live Game Save"),
    @("XboxNetApiSvc",           "Xbox Live Networking Service"),
    @("wercplsupport",           "Problem Reports Control Panel Support"),
    @("wbengine",                "Block Level Backup Engine Service"),
    @("WFDSConMgrSvc",           "Wi-Fi Direct Services Connection Manager")
)

foreach ($svc in $servicesToDisable) {
    $s = Get-Service -Name $svc[0] -ErrorAction SilentlyContinue
    if ($s) {
        if ($s.Status -eq "Running") { Stop-Service -Name $svc[0] -Force -ErrorAction SilentlyContinue }
        Set-Service -Name $svc[0] -StartupType Disabled -ErrorAction SilentlyContinue
        Write-Log "Disabled: $($svc[1]) ($($svc[0]))" "OK"
    } else {
        Write-Log "Not found (skip): $($svc[0])" "INFO"
    }
}

# -----------------------------------------------------------------------------
# SECTION 9 - WINDOWS FIREWALL LOGGING
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 9: Windows Firewall ---"

$fwLogDir = "$env:SystemRoot\System32\logfiles\firewall"
if (-not (Test-Path $fwLogDir)) {
    New-Item -Path $fwLogDir -ItemType Directory -Force | Out-Null
    Write-Log "Created firewall log directory" "OK"
}

foreach ($profile in @("domain","private","public")) {
    netsh advfirewall set ${profile}profile logging filename "$fwLogDir\${profile}fw.log" 2>$null | Out-Null
    netsh advfirewall set ${profile}profile logging maxfilesize 16384                      2>$null | Out-Null
    netsh advfirewall set ${profile}profile logging droppedconnections enable              2>$null | Out-Null
    netsh advfirewall set ${profile}profile logging allowedconnections enable              2>$null | Out-Null
    netsh advfirewall set ${profile}profile settings inboundusernotification disable       2>$null | Out-Null
    Write-Log "Firewall $profile profile configured" "OK"
}

# -----------------------------------------------------------------------------
# SECTION 17 - ADVANCED AUDIT POLICY
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 17: Advanced Audit Policy ---"

$audits = @(
    @("Credential Validation",        "enable", "enable"),
    @("Security Group Management",    "enable", "enable"),
    @("User Account Management",      "enable", "enable"),
    @("Account Lockout",              "enable", "enable"),
    @("Logon",                        "enable", "enable"),
    @("Logoff",                       "enable", "disable"),
    @("Special Logon",                "enable", "disable"),
    @("Removable Storage",            "enable", "enable"),
    @("Audit Policy Change",          "enable", "enable"),
    @("Authentication Policy Change", "enable", "disable"),
    @("Sensitive Privilege Use",      "enable", "enable"),
    @("Security System Extension",    "enable", "enable"),
    @("System Integrity",             "enable", "enable")
)

foreach ($a in $audits) {
    $s = if ($a[1] -eq "enable") { "/success:enable" } else { "/success:disable" }
    $f = if ($a[2] -eq "enable") { "/failure:enable" } else { "/failure:disable" }
    auditpol /set /subcategory:"$($a[0])" $s $f 2>$null | Out-Null
    Write-Log "Audit: $($a[0]) | Success=$($a[1]) Failure=$($a[2])" "OK"
}

# -----------------------------------------------------------------------------
# SECTION 18 - ADMINISTRATIVE TEMPLATES (partial)
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 18: Administrative Templates ---"

Set-RegValue "HKLM:\SOFTWARE\Microsoft\Cryptography\Wintrust\Config"                    "EnableCertPaddingCheck"            "1" "String"
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\kernel"            "DisableExceptionChainValidation"   0
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Services\NetBT\Parameters"                 "NodeType"                          2
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip6\Parameters"                "DisableIPSourceRouting"            2
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters"                 "DisableIPSourceRouting"            2
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Services\RasMan\Parameters"                "DisableSavePassword"               1
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters"                 "EnableICMPRedirect"                0
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters"                 "KeepAliveTime"                     300000
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters"                 "PerformRouterDiscovery"            0
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip6\Parameters"                "TcpMaxDataRetransmissions"         3
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters"                 "TcpMaxDataRetransmissions"         3
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\DNSClient"                   "DoHPolicy"                        2
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\DNSClient"                   "EnableMulticast"                  0
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\LanmanWorkstation"              "AllowInsecureGuestAuth"           0
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Peernet"                                "Disabled"                         1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System"                         "EnableCdp"                        0
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Messenger\Client"                       "CEIP"                             2
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\SQMClient\Windows"                      "CEIPEnable"                       0
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System"                         "DisableLockScreenAppNotifications" 1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\AdvertisingInfo"                "DisabledByGroupPolicy"            1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\Explorer"                       "NoAutoplayfornonVolume"           1
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer"        "NoAutorun"                        1
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer"        "NoDriveTypeAutoRun"               255
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\MicrosoftAccount"                       "DisableUserAuth"                  1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\OneDrive"                       "DisableFileSyncNGSC"              1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\Windows Search"                 "AllowCortana"                     0
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\Windows Search"                 "AllowCortanaAboveLock"            0
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\Windows Search"                 "AllowSearchToUseLocation"         0

# -----------------------------------------------------------------------------
# DONE
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "=== Round 1 complete. Log saved to: $LogFile ==="
Write-Log "Restart recommended for secedit and LSA changes to take full effect."
Write-Log ""
Write-Log "========================================================="
Write-Log "MANUAL REVIEW - Controls not applied (environment-dependent)"
Write-Log "========================================================="
Write-Log "The following controls were skipped. Disable only if not"
Write-Log "needed in your environment."
Write-Log ""
Write-Log "[5.1/5.2]  Bluetooth (BTAGService, bthserv)"
Write-Log "           Disable only if no Bluetooth peripherals are in use."
Write-Log "           Set-Service BTAGService -StartupType Disabled"
Write-Log "           Set-Service bthserv     -StartupType Disabled"
Write-Log ""
Write-Log "[5.17]     Print Spooler (Spooler)"
Write-Log "           Disable only if no local or network printing is needed."
Write-Log "           Stop-Service Spooler -Force"
Write-Log "           Set-Service Spooler -StartupType Disabled"
Write-Log ""
Write-Log "[5.5]      Geolocation Service (lfsvc)"
Write-Log "           Disabling breaks location features in apps and Maps."
Write-Log "           Set-Service lfsvc -StartupType Disabled"
Write-Log ""
Write-Log "[18.10.10.1] Camera access policy"
Write-Log "           Blocks webcam for video calls (Teams, Zoom, etc.)"
Write-Log "           Set-RegValue HKLM:\SOFTWARE\Policies\Microsoft\Camera AllowCamera 0"
Write-Log ""
Write-Log "[18.9.33.6.3/6.4] Standby states (S1-S3)"
Write-Log "           May interfere with sleep and hibernate behaviour."
Write-Log "           Set-RegValue HKLM:\SOFTWARE\Policies\Microsoft\Power\PowerSettings\abfc2519-3608-4c2a-94ea-171b0ed546ab ACSettingIndex 0"
Write-Log "           Set-RegValue HKLM:\SOFTWARE\Policies\Microsoft\Power\PowerSettings\abfc2519-3608-4c2a-94ea-171b0ed546ab DCSettingIndex 0"
Write-Log ""
Write-Log "[18.6.21.1] Minimise simultaneous connections"
Write-Log "           Relevant if switching between wired and wireless."
Write-Log "           Set-RegValue HKLM:\SOFTWARE\Policies\Microsoft\Windows\WcmSvc\GroupPolicy fMinimizeConnections 3"
Write-Log ""
Write-Log "Review full log: $LogFile"
