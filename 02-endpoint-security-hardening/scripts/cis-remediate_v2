#Requires -RunAsAdministrator
<#
.SYNOPSIS
    CIS Windows 11 Enterprise Benchmark v3.0.0 - Round 2 Remediation

.DESCRIPTION
    Covers the remaining registry-based controls not addressed in Round 1.
    Focuses on Section 18 full coverage including Defender/ASR, BitLocker
    policy, RDS hardening, PowerShell transcription, WinRM, event log sizes,
    SmartScreen, Windows Defender Application Guard, and telemetry controls.

.NOTES
    Run after cis_remediate_v1.ps1 and a system restart.
    Run from an elevated PowerShell session.
    Test in a lab/non-production environment before deploying.
#>

Set-StrictMode -Off
$ErrorActionPreference = "Continue"
$LogFile = "$env:TEMP\CIS_Remediation_Round2_$(Get-Date -Format 'yyyyMMdd_HHmm').log"

function Write-Log {
    param([string]$Msg, [string]$Level = "INFO")
    $ts = Get-Date -Format "HH:mm:ss"
    $line = "[$ts][$Level] $Msg"
    Write-Host $line -ForegroundColor $(if($Level -eq "OK"){"Green"} elseif($Level -eq "WARN"){"Yellow"} else{"Cyan"})
    Add-Content -Path $LogFile -Value $line
}

function Set-RegValue {
    param([string]$Path, [string]$Name, $Value, [string]$Type = "DWord")
    try {
        if (-not (Test-Path $Path)) { New-Item -Path $Path -Force | Out-Null }
        Set-ItemProperty -Path $Path -Name $Name -Value $Value -Type $Type -Force
        Write-Log "SET  $Path\$Name = $Value" "OK"
    } catch {
        Write-Log "FAIL $Path\$Name : $_" "WARN"
    }
}

Write-Log "=== CIS Win11 Enterprise - Round 2 Remediation Started ==="
Write-Log "Log file: $LogFile"
Write-Log ""

# -----------------------------------------------------------------------------
# SECTION 18 - WINDOWS DEFENDER / EXPLOIT PROTECTION
# -----------------------------------------------------------------------------
Write-Log "--- Section 18: Windows Defender & Exploit Protection ---"

$defPath  = "HKLM:\SOFTWARE\Policies\Microsoft\Windows Defender"
$rtpPath  = "$defPath\Real-Time Protection"
$spyPath  = "$defPath\Spyware"
$mpePath  = "$defPath\MpEngine"
$repPath  = "$defPath\Reporting"
$scanPath = "$defPath\Scan"

Set-RegValue $defPath  "DisableAntiSpyware"                       0
Set-RegValue $defPath  "DisableAntiVirus"                         0
Set-RegValue $rtpPath  "DisableBehaviorMonitoring"                0
Set-RegValue $rtpPath  "DisableOnAccessProtection"                0
Set-RegValue $rtpPath  "DisableScanOnRealtimeEnable"              0
Set-RegValue $rtpPath  "DisableIOAVProtection"                    0
Set-RegValue $mpePath  "EnableFileHashComputation"                1
Set-RegValue $repPath  "DisableGenericRePorts"                    0
Set-RegValue $scanPath "DisableEmailScanning"                     0
Set-RegValue $scanPath "DisableRemovableDriveScanning"            0
Set-RegValue $scanPath "DisableArchiveScanning"                   0

# -----------------------------------------------------------------------------
# SECTION 18 - ATTACK SURFACE REDUCTION (ASR) RULES
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 18: Attack Surface Reduction Rules ---"

$asrPath = "$defPath\Windows Defender Exploit Guard\ASR"
$asrRulesPath = "$asrPath\Rules"

Set-RegValue $asrPath "ExploitGuard_ASR_Rules" 1

$asrRules = @{
    "be9ba2d9-53ea-4cdc-84e5-9b1eeee46550" = 1  # Block executable content from email/webmail
    "d4f940ab-401b-4efc-aadc-ad5f3c50688a" = 1  # Block Office apps from creating child processes
    "3b576869-a4ec-4529-8536-b80a7769e899" = 1  # Block Office apps from creating executable content
    "75668c1f-73b5-4cf0-bb93-3ecf5cb7cc84" = 1  # Block Office apps from injecting into other processes
    "d3e037e1-3eb8-44c8-a917-57927947596d" = 1  # Block JavaScript/VBScript from launching downloaded executables
    "5beb7efe-fd9a-4556-801d-275e5ffc04cc" = 1  # Block execution of potentially obfuscated scripts
    "92e97fa1-2edf-4476-bdd6-9dd0b4dddc7b" = 1  # Block Win32 API calls from Office macros
    "01443614-cd74-433a-b99e-2ecdc07bfc25" = 1  # Block executable files unless they meet prevalence criteria
    "c1db55ab-c21a-4637-bb3f-a12568109d35" = 1  # Use advanced protection against ransomware
    "9e6c4e1f-7d60-472f-ba1a-a39ef669e4b2" = 1  # Block credential stealing from LSASS
    "d1e49aac-8f56-4280-b9ba-993a6d77406c" = 1  # Block process creations from PSExec/WMI
    "b2b3f03d-6a65-4f7b-a9c7-1c7ef74a9ba4" = 1  # Block untrusted/unsigned processes from USB
    "26190899-1602-49e8-8b27-eb1d0a1ce869" = 1  # Block Office communication app child processes
    "7674ba52-37eb-4a4f-a9a1-f0f9a1619a2c" = 1  # Block Adobe Reader child processes
    "e6db77e5-3df2-4cf1-b95a-636979351e5b" = 1  # Block persistence through WMI event subscription
}

foreach ($rule in $asrRules.GetEnumerator()) {
    Set-RegValue $asrRulesPath $rule.Key $rule.Value
}

# -----------------------------------------------------------------------------
# SECTION 18 - BITLOCKER POLICY
# Note: TPM-dependent controls will fail on VMs without a virtual TPM.
#       They are included for completeness and will log a WARN if not applied.
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 18: BitLocker Policy ---"

$blPath = "HKLM:\SOFTWARE\Policies\Microsoft\FVE"
Set-RegValue $blPath "UseAdvancedStartup"                     1
Set-RegValue $blPath "EnableBDEWithNoTPM"                     0
Set-RegValue $blPath "UseTPM"                                 1
Set-RegValue $blPath "UseTPMPIN"                              1
Set-RegValue $blPath "UseTPMKey"                              1
Set-RegValue $blPath "UseTPMKeyPIN"                           1
Set-RegValue $blPath "RecoveryKeyMessage"                     "Contact IT for BitLocker recovery key." "String"
Set-RegValue $blPath "OSRecovery"                             1
Set-RegValue $blPath "OSManageDRA"                            0
Set-RegValue $blPath "OSRecoveryPassword"                     1
Set-RegValue $blPath "OSRecoveryKey"                          0
Set-RegValue $blPath "OSHideRecoveryPage"                     0
Set-RegValue $blPath "OSActiveDirectoryBackup"                1
Set-RegValue $blPath "OSActiveDirectoryBackupRequire"         1
Set-RegValue $blPath "OSEncryptionType"                       1

# -----------------------------------------------------------------------------
# SECTION 18 - REMOTE DESKTOP SERVICES (RDS) HARDENING
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 18: Remote Desktop Services Hardening ---"

$rdsPath  = "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services"
Set-RegValue $rdsPath "fAllowUnsolicited"          0
Set-RegValue $rdsPath "fAllowToGetHelp"            0
Set-RegValue $rdsPath "DisablePasswordSaving"      1
Set-RegValue $rdsPath "fDisableCdm"                1
Set-RegValue $rdsPath "fEncryptRPCTraffic"         1
Set-RegValue $rdsPath "SecurityLayer"              2
Set-RegValue $rdsPath "UserAuthentication"         1
Set-RegValue $rdsPath "MinEncryptionLevel"         3
Set-RegValue $rdsPath "MaxIdleTime"                900000
Set-RegValue $rdsPath "MaxDisconnectionTime"       60000
Set-RegValue $rdsPath "fSingleSessionPerUser"      1
Set-RegValue $rdsPath "DeleteTempDirsOnExit"       1
Set-RegValue $rdsPath "PerSessionTempDir"          1

# -----------------------------------------------------------------------------
# SECTION 18 - POWERSHELL
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 18: PowerShell ---"

$psPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\PowerShell"
$psTxPath = "$psPath\Transcription"
$psScPath  = "$psPath\ScriptBlockLogging"
$psMPath   = "$psPath\ModuleLogging"

Set-RegValue $psPath   "ExecutionPolicy"           "RemoteSigned" "String"
Set-RegValue $psTxPath "EnableTranscripting"       1
Set-RegValue $psTxPath "EnableInvocationHeader"    1
Set-RegValue $psScPath "EnableScriptBlockLogging"  1
Set-RegValue $psScPath "EnableScriptBlockInvocationLogging" 1
Set-RegValue $psMPath  "EnableModuleLogging"       1

# -----------------------------------------------------------------------------
# SECTION 18 - WINRM
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 18: WinRM ---"

$winrmClientPath  = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WinRM\Client"
$winrmServicePath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WinRM\Service"

Set-RegValue $winrmClientPath  "AllowBasic"           0
Set-RegValue $winrmClientPath  "AllowUnencryptedTraffic" 0
Set-RegValue $winrmClientPath  "AllowDigest"          0
Set-RegValue $winrmServicePath "AllowBasic"           0
Set-RegValue $winrmServicePath "AllowUnencryptedTraffic" 0
Set-RegValue $winrmServicePath "DisableRunAs"         1

# -----------------------------------------------------------------------------
# SECTION 18 - EVENT LOG SIZES
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 18: Event Log Sizes ---"

$logBase = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\EventLog"
Set-RegValue "$logBase\Application" "MaxSize" 32768
Set-RegValue "$logBase\Security"    "MaxSize" 196608
Set-RegValue "$logBase\Setup"       "MaxSize" 32768
Set-RegValue "$logBase\System"      "MaxSize" 32768

# -----------------------------------------------------------------------------
# SECTION 18 - SMARTSCREEN
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 18: SmartScreen ---"

Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System"                              "EnableSmartScreen"             1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System"                              "ShellSmartScreenLevel"         "Block" "String"
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\MicrosoftEdge\PhishingFilter"                "EnabledV9"                     1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\MicrosoftEdge\PhishingFilter"                "PreventOverride"               1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\MicrosoftEdge\PhishingFilter"                "PreventOverrideAppRepUnknown"  1

# -----------------------------------------------------------------------------
# SECTION 18 - TELEMETRY & PRIVACY
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 18: Telemetry & Privacy ---"

Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection"  "AllowTelemetry"              0
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection"  "DisableEnterpriseAuthProxy"  1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection"  "LimitDiagnosticLogCollection" 1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection"  "DisableOneSettingsDownloads" 1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\AppCompat"       "DisableInventory"            1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\AppCompat"       "DisablePCA"                  1

# -----------------------------------------------------------------------------
# SECTION 18 - FIREWALL REGISTRY KEYS
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 18: Firewall Registry Policy Keys ---"

$fwBase = "HKLM:\SOFTWARE\Policies\Microsoft\WindowsFirewall"
foreach ($profile in @("DomainProfile","PrivateProfile","PublicProfile")) {
    Set-RegValue "$fwBase\$profile" "EnableFirewall"       1
    Set-RegValue "$fwBase\$profile" "DefaultInboundAction" 1
    Set-RegValue "$fwBase\$profile" "DisableNotifications" 0
}

# -----------------------------------------------------------------------------
# SECTION 18 - CREDENTIAL GUARD / DEVICE GUARD
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 18: Credential Guard / Device Guard ---"

$dgPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DeviceGuard"
Set-RegValue $dgPath "EnableVirtualizationBasedSecurity"    1
Set-RegValue $dgPath "RequirePlatformSecurityFeatures"      1
Set-RegValue $dgPath "HypervisorEnforcedCodeIntegrity"      1
Set-RegValue $dgPath "HVCIMATRequired"                      0
Set-RegValue $dgPath "LsaCfgFlags"                          1

# -----------------------------------------------------------------------------
# SECTION 18 - WINDOWS UPDATE
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 18: Windows Update ---"

$wuPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU"
Set-RegValue $wuPath "NoAutoUpdate"         0
Set-RegValue $wuPath "AUOptions"            4
Set-RegValue $wuPath "AutoInstallMinorUpdates" 1

Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate" "ExcludeWUDriversInQualityUpdate" 0
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate" "ManagePreviewBuilds"             1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate" "ManagePreviewBuildsPolicyValue"  0

# -----------------------------------------------------------------------------
# SECTION 18 - MISCELLANEOUS
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "--- Section 18: Miscellaneous Controls ---"

# Virtualization-based security for LSASS
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" "RunAsPPL" 1

# Disable NetBIOS name poisoning vector
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\DNSClient" "EnableMulticast" 0

# Early Launch Antimalware
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Policies\EarlyLaunch" "DriverLoadPolicy" 3

# App installer policy
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\AppInstaller" "EnableAppInstaller"         0
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\AppInstaller" "EnableMSAppInstallerProtocol" 0

# Disable autoplay / autorun (belt and suspenders with Round 1)
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows\Explorer" "NoAutoplayfornonVolume"    1
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer" "NoDriveTypeAutoRun" 255

# Print spooler - point and print restrictions
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Printers\PointAndPrint" "RestrictDriverInstallationToAdministrators" 1
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Printers\PointAndPrint" "NoWarningNoElevationOnInstall"              0
Set-RegValue "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Printers\PointAndPrint" "UpdatePromptSettings"                       0

# WPAD / WinHTTP
Set-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Internet Settings\WinHttp" "DisableWpad" 1

# NetBT NodeType hardening
Set-RegValue "HKLM:\SYSTEM\CurrentControlSet\Services\NetBT\Parameters" "NodeType" 2

# -----------------------------------------------------------------------------
# DONE
# -----------------------------------------------------------------------------
Write-Log ""
Write-Log "=== Round 2 complete. Log saved to: $LogFile ==="
Write-Log "A system restart is required for all settings to take effect."
Write-Log "Re-run the Wazuh SCA scan after restart to verify compliance score."
